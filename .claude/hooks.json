{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "edit|create",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "git commit",
        "hooks": [
          {
            "type": "command",
            "command": "bd sync 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
