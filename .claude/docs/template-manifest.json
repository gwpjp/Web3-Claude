{
  "$schema": "Manifest of .claude files for porting to new projects",
  "version": "2.0.0",
  "targetStack": {
    "framework": "React 18+",
    "language": "TypeScript",
    "dataFetching": "TanStack Query v5",
    "blockchain": "wagmi v3 + viem v2",
    "indexer": "@ponder/react",
    "ui": "MUI v5+",
    "build": "Vite",
    "packageManager": "yarn"
  },
  "files": {
    "copy": {
      "description": "Copy without modification",
      "root": ["settings.json", "settings.local.json", "hooks.json"],
      "commands": [
        "commands/fix-number-format.md",
        "commands/commit-push-pr.md"
      ],
      "docs": ["docs/data-patterns.md"],
      "skills": [
        "skills/verify/SKILL.md",
        "skills/verify-app/SKILL.md",
        "skills/skill-sync/SKILL.md",
        "skills/skill-sync/sync-targets.md",
        "skills/skills-creator/SKILL.md",
        "skills/ralph-loop/SKILL.md",
        "skills/ralph-loop/guardrails.md",
        "skills/analyze-theme/SKILL.md",
        "skills/new-component/SKILL.md",
        "skills/new-hook/SKILL.md",
        "skills/monitor/SKILL.md",
        "skills/monitor/patterns.md"
      ],
      "agents": [
        "agents/domain/ui-designer.md",
        "agents/domain/design-dialogue.md",
        "agents/domain/theme-ui-specialist.md",
        "agents/domain/react-specialist.md",
        "agents/domain/web3-implementer.md",
        "agents/domain/wagmi-specialist.md",
        "agents/domain/ponder-schema-specialist.md",
        "agents/domain/react-query-specialist.md",
        "agents/domain/typescript-specialist.md",
        "agents/domain/code-refactor-specialist.md",
        "agents/design/ui-design-specialist.md",
        "agents/design/ui-design-jony-ive.md",
        "agents/qa/visual-qa.md",
        "agents/qa/visual-qa-chrome-profiler.md",
        "agents/qa/visual-qa-lighthouse.md",
        "agents/qa/visual-qa-react-devtools-profiler.md",
        "agents/qa/visual-qa-react-analyzer.md",
        "agents/qa/accessibility-auditor.md",
        "agents/qa/responsive-tester.md",
        "agents/qa/performance-auditor.md",
        "agents/qa/form-edge-case-tester.md",
        "agents/refactor/code-simplifier.md",
        "agents/refactor/ui-refactor-specialist.md",
        "agents/refactor/types-refactor-specialist.md"
      ],
      "knowledge": [
        "knowledge/design/dialogue-format.md",
        "knowledge/design/anti-slop-patterns.md",
        "knowledge/design/design-philosophy.md",
        "knowledge/qa/qa-prerequisites.md",
        "knowledge/qa/react-anti-patterns.md"
      ]
    },
    "parameterize": {
      "description": "Copy and replace entity names with your project's domain entities",
      "files": [
        "CLAUDE.md",
        "README.md",
        "docs/project-rules.md",
        "docs/component-reference.md",
        "skills/agent-orchestrator/SKILL.md",
        "knowledge/orchestrator/agent-registry.md",
        "agents/domain/web3-implementer.md",
        "knowledge/domain/hook-patterns.md",
        "knowledge/domain/project-config.json",
        "agents/qa/form-edge-case-tester.md"
      ]
    },
    "regenerate": {
      "description": "Must be regenerated from source code",
      "files": [
        {
          "target": "docs/theme-reference.md",
          "source": "src/theme/themeConfig.tsx",
          "instructions": "Extract palette colors and typography variants into markdown tables"
        },
        {
          "target": "knowledge/domain/schema-reference.md",
          "source": "ponder.schema.ts or src/services/ponder/ponder.schema.ts",
          "instructions": "Run `npx tsx scripts/generate-schema-reference.ts` if script exists, otherwise extract tables, columns, types, indexes, relations"
        },
        {
          "target": "knowledge/domain/hook-reference.md",
          "source": "src/hooks/blockchain/",
          "instructions": "Scan directory for all hooks, categorize by type (read, write, transform), document params and returns"
        },
        {
          "target": "knowledge/domain/contracts-reference.md",
          "source": "src/services/contracts/generated.ts",
          "instructions": "Scan for ABI exports, categorize by domain, document key functions and hook-to-contract mapping"
        },
        {
          "target": "knowledge/domain/ponder-reference.md",
          "source": "src/hooks/ponder/",
          "instructions": "Catalog all ponder hooks with their query patterns"
        },
        {
          "target": "knowledge/domain/type-index.json",
          "source": "src/types/",
          "instructions": "Index all exported interfaces, types, and transform functions"
        }
      ]
    },
    "projectSpecific": {
      "description": "Must be created new for each project",
      "files": [
        {
          "target": "agents/qa/routes.json",
          "instructions": "Define all app routes with QA focus areas for each page"
        },
        {
          "target": "knowledge/domain/design-patterns.md",
          "instructions": "Document page layouts, card sections, form patterns specific to this project"
        },
        {
          "target": "commands/update-contracts.md",
          "instructions": "Document contract address/ABI update workflow if applicable"
        },
        {
          "target": "docs/PROTOCOL_SPECIFICATION.md",
          "instructions": "Optional: Document domain-specific protocol knowledge"
        }
      ]
    }
  },
  "scripts": {
    "description": "Utility scripts for DeFi protocol data",
    "files": ["scripts/defillama.mjs"]
  },
  "validation": {
    "requiredAfterSetup": [
      "yarn typecheck passes",
      "yarn lint passes",
      "yarn build passes",
      "/verify skill works",
      "/agent-orchestrator loads without errors",
      "CLAUDE.md loads in new Claude Code session"
    ]
  }
}
